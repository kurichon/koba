{
  "manifest_version": 3,
  "name": "JPDB Review Button for ChatGPT",
  "version": "0.3.1",
  "description": "Manual JPDB vocabulary reviews beside ChatGPT.",
  "permissions": [
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://jpdb.io/*",
    "https://chatgpt.com/*",
    "https://chat.openai.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "JPDB Review Button settings"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
